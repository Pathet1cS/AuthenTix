# Copy to .env.local and fill in.

# Thirdweb client ID (thirdweb.com dashboard). Add localhost to its allowed domains for dev.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Backend API base URL, no trailing slash. Backend PORT defaults to 3001.
# The backend's AUTH_DOMAIN must equal this app's host (e.g. localhost:3000),
# otherwise every login is rejected with "Invalid login domain".
NEXT_PUBLIC_API_URL=http://localhost:3001
