PORT=3001
MONGO_URI=mongodb://localhost:27017/authentix
JWT_SECRET=<generate: openssl rand -hex 32>
THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key
RELAYER_PRIVATE_KEY=0xyour_relayer_private_key
PINATA_JWT=your_pinata_jwt
# Dedicated gateway domain, e.g. example.mypinata.cloud. Read-only; optional for now.
PINATA_GATEWAY=
CONTRACT_ADDRESS=0xyour_deployed_contract_address
RPC_URL=https://sepolia.optimism.io
# Domain the login payload must be bound to (must match the frontend origin).
AUTH_DOMAIN=localhost:3000

# ===== Blockchain Event Listener Configuration =====
# WebSocket RPC URL for real-time event listening (optional, fallback to HTTP polling if not set)
WS_RPC_URL=wss://sepolia.optimism.io
# Block number where the EventTicketNFT contract was deployed (used as starting point for catch-up)
CONTRACT_DEPLOYMENT_BLOCK=14325678
# Number of blocks to query per batch during historical log catch-up (default: 1000)
LISTENER_BATCH_SIZE=1000
# Number of blocks between checkpoint updates during real-time listening (default: 10)
LISTENER_CHECKPOINT_INTERVAL=10
